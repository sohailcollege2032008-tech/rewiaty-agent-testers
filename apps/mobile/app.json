{
  "expo": {
    "name": "روايتي",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rewiaty",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.rewiaty.app"
    },
    "android": {
      "package": "com.rewiaty.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "scheme": "content", "mimeType": "text/markdown" },
            { "scheme": "file", "mimeType": "text/markdown" },
            { "scheme": "content", "mimeType": "text/plain" },
            { "scheme": "file", "mimeType": "text/plain" },
            { "scheme": "content", "mimeType": "text/x-markdown" },
            { "scheme": "file", "mimeType": "text/x-markdown" }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "scheme": "content",
              "host": "*",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\.md"
            },
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\.md"
            },
            {
              "scheme": "content",
              "host": "*",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\.MD"
            },
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\.MD"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-asset",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
